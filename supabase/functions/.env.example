# Server-side only. Copy to .env (ignored); never include it in the app.
# Optional independent rate-limit key; otherwise derived from injected server credentials.
# USAGE_RATE_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Optional; the in-app admin dashboard works without PostHog.
# POSTHOG_PROJECT_TOKEN=YOUR_PROJECT_TOKEN
# POSTHOG_HOST=https://us.i.posthog.com
